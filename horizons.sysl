/** The whole system as Horizons has it at `horizons_dates[d]`. */
horizons_system(d: int) -> System
    var names = buf[string]()
    var gm = buf[real]()
    var pos = buf[Vec3]()
    var vel = buf[Vec3]()

    for b in 0..<11
        val s = horizons_states[d][b]
        names.push(body_names[b])
        gm.push(gm_au(body_gm_km[b]))
        pos.push(Vec3(s[0], s[1], s[2]))
        vel.push(Vec3(s[3], s[4], s[5]))
    system(names, gm, pos, vel, horizons_dates[d])
end horizons_system
