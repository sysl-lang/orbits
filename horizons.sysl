// JPL Horizons state vectors (DE441), fetched once on 2026-10-14 and committed; the raw replies
// are in fixtures/horizons/. The query, with <code> each of 10 199 299 399 301 4 5 6 7 8 9:
//
//     curl -s "https://ssd.jpl.nasa.gov/api/horizons.api?format=text&COMMAND='<code>'&OBJ_DATA='NO'&MAKE_EPHEM='YES'&EPHEM_TYPE='VECTORS'&CENTER='500@0'&REF_PLANE='ECLIPTIC'&REF_SYSTEM='ICRF'&VEC_TABLE='2'&OUT_UNITS='AU-D'&CSV_FORMAT='YES'&VEC_LABELS='NO'&TLIST='2451545.0','2451575.0','2451910.25','2455197.5'"
//
// Barycentric (500@0), ecliptic and mean equinox of J2000, TDB, AU and AU/day. Mars through
// Pluto are system barycentres, which is what their GM (planet plus moons) is the mass of.
//
// GM values are DE440's (km^3/s^2, the same constants DE441 uses), converted to AU^3/day^2 by
// `gm_au`.

import sysl.buf.{Buf, buf}

/** The four Julian dates (TDB) fetched: the J2000 epoch, +30 d, +1 Julian year, +10 Julian years. */
val horizons_dates: [4]real = [2451545.0, 2451575.0, 2451910.25, 2455197.5]

val body_names: [11]string = ["Sun", "Mercury", "Venus", "Earth", "Moon", "Mars", "Jupiter", "Saturn", "Uranus", "Neptune", "Pluto"]

private const au_km: real = 149597870.7
private const day_s: real = 86400.0

/** km^3/s^2 to AU^3/day^2. */
gm_au(km3s2: real) -> real = km3s2 * (day_s * day_s) / (au_km * au_km * au_km)

val body_gm_km: [11]real = [
    132712440041.279419,
    22031.868551,
    324858.592000,
    398600.435507,
    4902.800118,
    42828.375816,
    126712764.100000,
    37940584.841800,
    5794556.400000,
    6836527.100580,
    975.500000]

/** `horizons_states[d][b]` is body `b`'s `[x, y, z, vx, vy, vz]` at `horizons_dates[d]`. */
